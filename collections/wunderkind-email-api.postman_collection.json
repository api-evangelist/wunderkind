          "id": "a085f124-5c11-41ba-be5d-a1813be1e90c",
          "name": "Send Email",
          "request": {
            "name": "Send Email",
            "description": {
              "content": "Send an email to one or more recipients through the Wunderkind email delivery platform to a subscribers\nof the website id set by wunderkind.\n\nThis endpoint supports both HTML and plain text email content, custom sender information,\nand flexible recipient management. All emails are processed synchronously.\n\n**Important Notes:**\n- All recipient email addresses must be valid and properly formatted\n- The sender email address must be verified and susbcribed for the website id set by wunderkind\n- If the email address is not subscribed, system silently ignores\n- HTML content should be properly encoded and sanitized\n- Large recipient lists may experience delayed processing\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "email",
                "send"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"to_emails\": [\n    \"<email>\"\n  ],\n  \"subject\": \"<string>\",\n  \"from\": \"<email>\",\n  \"body\": \"<string>\",\n  \"from_name\": \"<string>\",\n  \"reply_to\": \"<email>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
